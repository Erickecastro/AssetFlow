<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AssetFlow.Mobile.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="White" Title="AssetFlow">
    <ContentPage.Resources>
        <Style TargetType="Label"><Setter Property="FontFamily" Value="CascadiaCode" /><Setter Property="TextColor" Value="Black" /></Style>
        <Style TargetType="Entry"><Setter Property="FontFamily" Value="CascadiaCode" /><Setter Property="TextColor" Value="Black" /><Setter Property="PlaceholderColor" Value="#686868" /><Setter Property="BackgroundColor" Value="White" /><Setter Property="HeightRequest" Value="48" /><Setter Property="MinimumWidthRequest" Value="120" /></Style>
        <Style TargetType="Editor"><Setter Property="FontFamily" Value="CascadiaCode" /><Setter Property="TextColor" Value="Black" /><Setter Property="PlaceholderColor" Value="#686868" /><Setter Property="BackgroundColor" Value="White" /><Setter Property="MinimumHeightRequest" Value="70" /></Style>
        <Style TargetType="Picker"><Setter Property="FontFamily" Value="CascadiaCode" /><Setter Property="FontSize" Value="14" /><Setter Property="TextColor" Value="Black" /><Setter Property="TitleColor" Value="#686868" /><Setter Property="BackgroundColor" Value="White" /><Setter Property="HeightRequest" Value="66" /><Setter Property="MinimumHeightRequest" Value="66" /><Setter Property="HorizontalOptions" Value="Fill" /><Setter Property="VerticalTextAlignment" Value="Center" /></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="BackgroundColor" Value="White" /><Setter Property="Stroke" Value="#D8D8D8" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="StrokeShape" Value="RoundRectangle 10" /><Setter Property="Padding" Value="16" /></Style>
        <Style x:Key="FieldLabel" TargetType="Label"><Setter Property="FontSize" Value="11" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="Margin" Value="0,2,0,0" /></Style>
        <Style x:Key="CardTitle" TargetType="Label"><Setter Property="FontSize" Value="16" /><Setter Property="FontAttributes" Value="Bold" /></Style>
        <Style x:Key="NavButton" TargetType="Button"><Setter Property="BackgroundColor" Value="White" /><Setter Property="TextColor" Value="Black" /><Setter Property="BorderColor" Value="White" /><Setter Property="HorizontalOptions" Value="Fill" /><Setter Property="Padding" Value="14,11" /></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="White" /><Setter Property="TextColor" Value="Black" /><Setter Property="BorderColor" Value="Black" /><Setter Property="BorderWidth" Value="1" /></Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid x:Name="AuthenticatedHeader" IsVisible="{Binding IsAuthenticated}" Padding="18,10" BackgroundColor="White" ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="12">
            <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="MobileHeader"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="AdminProfile" Property="IsVisible" Value="False" /><Setter TargetName="AuthenticatedHeader" Property="Padding" Value="12,8" /></VisualState.Setters></VisualState><VisualState x:Name="DesktopHeader"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="AdminProfile" Property="IsVisible" Value="True" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
            <Label Text="≡" FontSize="27" VerticalOptions="Center" />
            <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto" ColumnSpacing="9" VerticalOptions="Center">
                <Label Text="▲" FontSize="22" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="ASSETFLOW" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>
            <Button x:Name="SyncButton" Grid.Column="3" Text="↻" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" />
            <Grid x:Name="AdminProfile" Grid.Column="4" IsVisible="False" ColumnDefinitions="Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Image Source="icon_profile.png" WidthRequest="34" HeightRequest="34" Aspect="AspectFit" />
                <Label Grid.Column="1" Text="Administrador" FontSize="12" VerticalOptions="Center" />
            </Grid>
        </Grid>

        <!-- A tela de login foi mantida com a composição anterior. -->
        <ScrollView Grid.Row="1" IsVisible="{Binding IsLoggedOut}">
            <Grid BackgroundColor="White" Padding="24" MinimumHeightRequest="640">
                <Border BackgroundColor="White" Stroke="White" MaximumWidthRequest="420" HorizontalOptions="Fill" VerticalOptions="Center" Padding="32" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="18" VerticalOptions="Center">
                        <Border BackgroundColor="Black" Stroke="Black" WidthRequest="58" HeightRequest="58" HorizontalOptions="Center" StrokeShape="RoundRectangle 12"><Label Text="AF" TextColor="White" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" /></Border>
                        <Label Text="Login" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,4,0,12" />
                        <Label Text="Usuário" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Digite seu usuário" Text="{Binding Username}" />
                        <Label Text="Senha" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Digite sua senha" Text="{Binding Password}" IsPassword="True" />
                        <Button Text="ENTRAR" Command="{Binding LoginCommand}" BackgroundColor="Black" TextColor="White" Margin="0,12,0,0" />
                        <BoxView HeightRequest="1" BackgroundColor="Black" Margin="0,14,0,4" />
                        <Label Text="AssetFlow Experimental" FontSize="12" HorizontalTextAlignment="Center" />
                        <Label Text="Gestão segura do ciclo de vida de ativos" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <Grid x:Name="AuthenticatedShell" Grid.Row="1" IsVisible="{Binding IsAuthenticated}" ColumnDefinitions="*" RowDefinitions="Auto,*">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="MobileShell"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter TargetName="DesktopSidebar" Property="IsVisible" Value="False" /><Setter TargetName="MobileNavigation" Property="IsVisible" Value="True" /><Setter TargetName="DashboardContent" Property="Grid.Row" Value="1" /><Setter TargetName="DashboardContent" Property="Grid.Column" Value="0" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="DesktopShell"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter TargetName="AuthenticatedShell" Property="ColumnDefinitions" Value="230,*" /><Setter TargetName="AuthenticatedShell" Property="RowDefinitions" Value="*" /><Setter TargetName="DesktopSidebar" Property="IsVisible" Value="True" /><Setter TargetName="MobileNavigation" Property="IsVisible" Value="False" /><Setter TargetName="DashboardContent" Property="Grid.Row" Value="0" /><Setter TargetName="DashboardContent" Property="Grid.Column" Value="1" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="DesktopSidebar" IsVisible="False" BackgroundColor="White" Padding="10,16,10,12" RowDefinitions="*,Auto">
                <VerticalStackLayout Spacing="5">
                    <Button Text="▦  Dashboard" BackgroundColor="Black" TextColor="White" Padding="14,11" />
                    <Button Text="▣  Inventário" Style="{StaticResource NavButton}" /><Button Text="◇  Ativos" Style="{StaticResource NavButton}" />
                    <Button Text="▤  Departamentos" Style="{StaticResource NavButton}" /><Button Text="⇅  Movimentações" Style="{StaticResource NavButton}" />
                    <Button Text="▥  Relatórios" Style="{StaticResource NavButton}" /><Button Text="◎  Usuários" Style="{StaticResource NavButton}" />
                    <Button Text="⚙  Configurações" Style="{StaticResource NavButton}" />
                </VerticalStackLayout>
                <Button Grid.Row="1" Text="↪  Sair" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}" />
            </Grid>
            <ScrollView x:Name="MobileNavigation" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="10,8">
                <HorizontalStackLayout Spacing="8"><Button Text="▦ Dashboard" BackgroundColor="Black" TextColor="White" /><Button Text="▣ Inventário" Style="{StaticResource SecondaryButton}" /><Button Text="▤ Departamentos" Style="{StaticResource SecondaryButton}" /><Button Text="⇅ Movimentações" Style="{StaticResource SecondaryButton}" /><Button Text="↪ Sair" Command="{Binding LogoutCommand}" Style="{StaticResource SecondaryButton}" /></HorizontalStackLayout>
            </ScrollView>

            <Grid x:Name="DashboardContent" Grid.Row="1" BackgroundColor="#FAFAFA">
                <ScrollView x:Name="AuthenticatedScroll">
                    <VerticalStackLayout Padding="24" Spacing="18">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3"><Label Text="Dashboard" FontSize="25" FontAttributes="Bold" /><Label Text="Visão geral do inventário de ativos" FontSize="12" TextColor="#555555" /></VerticalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="Black" Stroke="Black" StrokeShape="RoundRectangle 10" Padding="14,9" VerticalOptions="Center" SemanticProperties.Description="Novo ativo">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNewAssetClicked" /></Border.GestureRecognizers>
                                <Grid ColumnDefinitions="18,Auto" ColumnSpacing="8">
                                    <Image Source="icon_add.png" WidthRequest="18" HeightRequest="18" Aspect="AspectFit" />
                                    <Label Grid.Column="1" Text="Novo ativo" TextColor="White" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="StatsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <VisualStateManager.VisualStateGroups><VisualStateGroup>
                                <VisualState x:Name="CompactStats"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState>
                                <VisualState x:Name="WideStats"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="StatsGrid" Property="ColumnDefinitions" Value="*,*,*,*" /><Setter TargetName="StatsGrid" Property="RowDefinitions" Value="Auto" /><Setter TargetName="AvailableCard" Property="Grid.Row" Value="0" /><Setter TargetName="AvailableCard" Property="Grid.Column" Value="1" /><Setter TargetName="AssignedCard" Property="Grid.Row" Value="0" /><Setter TargetName="AssignedCard" Property="Grid.Column" Value="2" /><Setter TargetName="MaintenanceCard" Property="Grid.Row" Value="0" /><Setter TargetName="MaintenanceCard" Property="Grid.Column" Value="3" /></VisualState.Setters></VisualState>
                            </VisualStateGroup></VisualStateManager.VisualStateGroups>
                            <Border Style="{StaticResource Card}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Image Source="icon_total_assets.png" WidthRequest="54" HeightRequest="54" Aspect="AspectFit" /><VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center"><Label Text="Total de ativos" FontSize="11" /><Label Text="{Binding TotalAssetCount}" FontSize="26" FontAttributes="Bold" /><Label Text="Todos cadastrados" FontSize="10" TextColor="#666666" /></VerticalStackLayout></Grid></Border>
                            <Border x:Name="AvailableCard" Grid.Column="1" Style="{StaticResource Card}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Image Source="icon_available.png" WidthRequest="54" HeightRequest="54" Aspect="AspectFit" /><VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center"><Label Text="Disponíveis" FontSize="11" /><Label Text="{Binding AvailableAssetCount}" FontSize="26" FontAttributes="Bold" /><Label Text="Prontos para uso" FontSize="10" TextColor="#666666" /></VerticalStackLayout></Grid></Border>
                            <Border x:Name="AssignedCard" Grid.Row="1" Style="{StaticResource Card}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Image Source="icon_assigned.png" WidthRequest="54" HeightRequest="54" Aspect="AspectFit" /><VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center"><Label Text="Atribuídos" FontSize="11" /><Label Text="{Binding AssignedAssetCount}" FontSize="26" FontAttributes="Bold" /><Label Text="Ativos em uso" FontSize="10" TextColor="#666666" /></VerticalStackLayout></Grid></Border>
                            <Border x:Name="MaintenanceCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Image Source="icon_maintenance.png" WidthRequest="54" HeightRequest="54" Aspect="AspectFit" /><VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center"><Label Text="Manutenção" FontSize="11" /><Label Text="{Binding MaintenanceAssetCount}" FontSize="26" FontAttributes="Bold" /><Label Text="Em manutenção" FontSize="10" TextColor="#666666" /></VerticalStackLayout></Grid></Border>
                        </Grid>

                        <Grid x:Name="FormsGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                            <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="StackedForms"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState><VisualState x:Name="SideForms"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="FormsGrid" Property="ColumnDefinitions" Value="1.05*,1.95*" /><Setter TargetName="FormsGrid" Property="RowDefinitions" Value="Auto" /><Setter TargetName="AssetFormCard" Property="Grid.Row" Value="0" /><Setter TargetName="AssetFormCard" Property="Grid.Column" Value="1" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
                            <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="7"><Label Text="Cadastrar departamento" Style="{StaticResource CardTitle}" /><Label Text="Nome" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Ex.: Tecnologia" Text="{Binding DepartmentName}" /><Label Text="Descrição / localização" Style="{StaticResource FieldLabel}" /><Editor Placeholder="Ex.: Responsável pelos recursos de TI" Text="{Binding DepartmentDescription}" AutoSize="TextChanges" /><Button Text="Adicionar departamento" Command="{Binding AddDepartmentCommand}" BackgroundColor="Black" TextColor="White" Margin="0,6,0,0" /></VerticalStackLayout></Border>
                            <Border x:Name="AssetFormCard" Grid.Row="1" Style="{StaticResource Card}"><VerticalStackLayout Spacing="7"><Label Text="Cadastrar ativo" Style="{StaticResource CardTitle}" /><Grid x:Name="AssetFields" ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5"><VerticalStackLayout><Label Text="Código patrimonial" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Ex.: PAT-0001" Text="{Binding AssetCode}" /></VerticalStackLayout><VerticalStackLayout x:Name="SerialField" Grid.Row="1"><Label Text="Número de série" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Ex.: SN-123" Text="{Binding AssetSerialNumber}" /></VerticalStackLayout><VerticalStackLayout x:Name="AssetNameField" Grid.Row="2"><Label Text="Nome do ativo" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Ex.: Notebook Dell Latitude" Text="{Binding AssetName}" /></VerticalStackLayout><VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="StackedAssetFields"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState><VisualState x:Name="SideAssetFields"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="AssetFields" Property="ColumnDefinitions" Value="*,*,*" /><Setter TargetName="AssetFields" Property="RowDefinitions" Value="Auto" /><Setter TargetName="SerialField" Property="Grid.Row" Value="0" /><Setter TargetName="SerialField" Property="Grid.Column" Value="1" /><Setter TargetName="AssetNameField" Property="Grid.Row" Value="0" /><Setter TargetName="AssetNameField" Property="Grid.Column" Value="2" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups></Grid><Label Text="Descrição personalizada" Style="{StaticResource FieldLabel}" /><Editor Placeholder="Detalhes, características e observações" Text="{Binding AssetDescription}" AutoSize="TextChanges" /><Button Text="Adicionar ao inventário" Command="{Binding AddAssetCommand}" BackgroundColor="Black" TextColor="White" Margin="0,6,0,0" /></VerticalStackLayout></Border>
                        </Grid>

                        <Grid x:Name="ListsGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                            <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="StackedLists"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState><VisualState x:Name="SideLists"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="ListsGrid" Property="ColumnDefinitions" Value="1.05*,1.95*" /><Setter TargetName="ListsGrid" Property="RowDefinitions" Value="Auto" /><Setter TargetName="InventoryCard" Property="Grid.Row" Value="0" /><Setter TargetName="InventoryCard" Property="Grid.Column" Value="1" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
                            <Border Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="*,Auto"><Label Text="◇  Departamentos" Style="{StaticResource CardTitle}" /><Label Grid.Column="1" Text="{Binding Departments.Count, StringFormat='Total: {0}'}" FontSize="11" VerticalOptions="Center" /></Grid><BoxView HeightRequest="1" BackgroundColor="#E0E0E0" /><VerticalStackLayout BindableLayout.ItemsSource="{Binding Departments}"><BindableLayout.ItemTemplate><DataTemplate><Grid Padding="3,9" ColumnDefinitions="36,*,Auto" ColumnSpacing="9"><Border BackgroundColor="#F2F2F2" Stroke="#F2F2F2" WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16"><Label Text="◇" HorizontalOptions="Center" VerticalOptions="Center" /></Border><VerticalStackLayout Grid.Column="1" Spacing="0"><Label Text="{Binding Name}" FontAttributes="Bold" FontSize="12" LineBreakMode="TailTruncation" /><Label Text="{Binding Description}" FontSize="10" TextColor="#666666" LineBreakMode="TailTruncation" /></VerticalStackLayout><Label Grid.Column="2" Text="›" FontSize="20" VerticalOptions="Center" /></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout></Border>
                            <Border x:Name="InventoryCard" Grid.Row="1" Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="*,Auto"><Label Text="◇  Inventário de ativos" Style="{StaticResource CardTitle}" /><Label Grid.Column="1" Text="{Binding Assets.Count, StringFormat='Total: {0}'}" FontSize="11" VerticalOptions="Center" /></Grid><Grid Padding="5,7" ColumnDefinitions="1.25*,2*,1*" ColumnSpacing="12"><Label Text="CÓDIGO" Style="{StaticResource FieldLabel}" /><Label Grid.Column="1" Text="ATIVO" Style="{StaticResource FieldLabel}" /><Label Grid.Column="2" Text="STATUS" Style="{StaticResource FieldLabel}" /></Grid><CollectionView ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" SelectionMode="Single" HeightRequest="270"><CollectionView.ItemTemplate><DataTemplate><Grid Padding="5,10" ColumnDefinitions="1.25*,2*,1*" ColumnSpacing="12"><Label Text="{Binding Code}" FontAttributes="Bold" FontSize="11" LineBreakMode="TailTruncation" /><VerticalStackLayout Grid.Column="1" Spacing="0"><Label Text="{Binding Name}" FontAttributes="Bold" FontSize="11" LineBreakMode="TailTruncation" /><Label Text="{Binding Description}" FontSize="9" TextColor="#666666" LineBreakMode="TailTruncation" /></VerticalStackLayout><Border Grid.Column="2" BackgroundColor="#EEEEEE" Stroke="#EEEEEE" Padding="8,4" StrokeShape="RoundRectangle 10" VerticalOptions="Center"><Label Text="{Binding StatusName}" FontSize="9" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" /></Border></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></Border>
                        </Grid>

                        <Border IsVisible="{Binding HasSelectedAsset}" Style="{StaticResource Card}">
                            <Grid x:Name="DetailsGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="12">
                                <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="StackedDetails"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState><VisualState x:Name="SideDetails"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="DetailsGrid" Property="ColumnDefinitions" Value="1.2*,1.8*" /><Setter TargetName="DetailsGrid" Property="RowDefinitions" Value="Auto" /><Setter TargetName="HistoryPanel" Property="Grid.Row" Value="0" /><Setter TargetName="HistoryPanel" Property="Grid.Column" Value="1" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
                                <VerticalStackLayout Spacing="8"><Label Text="Ativo selecionado" Style="{StaticResource CardTitle}" /><Label Text="{Binding SelectedAsset.Summary}" FontAttributes="Bold" /><Label Text="{Binding SelectedAsset.StatusName, StringFormat='Status atual: {0}'}" FontSize="11" /><Label Text="IDENTIFICADOR QR" Style="{StaticResource FieldLabel}" /><Label Text="{Binding SelectedAsset.QrCodeValue}" FontSize="10" LineBreakMode="TailTruncation" /><Button Text="Copiar identificador QR" Command="{Binding CopyQrCommand}" Style="{StaticResource SecondaryButton}" /><Label Text="DEPARTAMENTO DE DESTINO" Style="{StaticResource FieldLabel}" /><Picker Title="Selecione um departamento" ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" ItemDisplayBinding="{Binding Name}" /><Label Text="OBSERVAÇÕES" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Motivo ou detalhes da movimentação" Text="{Binding MovementNotes}" /><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Text="{Binding MoveButtonText}" Command="{Binding MoveAssetCommand}" BackgroundColor="Black" TextColor="White" /><Button Grid.Column="1" Text="Devolver" Command="{Binding ReturnAssetCommand}" Style="{StaticResource SecondaryButton}" /></Grid></VerticalStackLayout>
                                <VerticalStackLayout x:Name="HistoryPanel" Grid.Row="1" Spacing="8"><Label Text="Histórico de movimentações" Style="{StaticResource CardTitle}" /><Label IsVisible="{Binding SelectedAsset.HasNoMovements}" Text="Este ativo ainda não possui movimentações." FontSize="11" Padding="0,10" /><VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedAsset.Movements}"><BindableLayout.ItemTemplate><DataTemplate><Grid Padding="10" ColumnDefinitions="5,*" ColumnSpacing="10"><BoxView BackgroundColor="Black" /><Label Grid.Column="1" Text="{Binding Summary}" FontSize="11" VerticalOptions="Center" /></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Grid ColumnDefinitions="Auto,*" Padding="0,10"><Label Text="▲ ASSETFLOW" FontAttributes="Bold" FontSize="11" /><Label Grid.Column="1" Text="AssetFlow experimental" HorizontalTextAlignment="End" FontSize="10" TextColor="#666666" /></Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Padding="16,8" BackgroundColor="Black" ColumnDefinitions="Auto,*">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="White" />
            <Label Grid.Column="1" Text="{Binding StatusMessage}" TextColor="White" FontSize="11" VerticalOptions="Center" LineBreakMode="TailTruncation" />
        </Grid>
    </Grid>
</ContentPage>
