<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="AssetFlow.Mobile.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             BackgroundColor="White" Title="AssetFlow">
    <ContentPage.Resources>
        <Style TargetType="Label"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="TextColor" Value="#111827" /></Style>
        <Style TargetType="Button"><Setter Property="FontFamily" Value="Segoe UI" /></Style>
        <Style TargetType="Entry"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="TextColor" Value="#111827" /><Setter Property="PlaceholderColor" Value="#6B7280" /><Setter Property="BackgroundColor" Value="White" /><Setter Property="HeightRequest" Value="48" /><Setter Property="MinimumWidthRequest" Value="120" /></Style>
        <Style TargetType="Editor"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="TextColor" Value="#111827" /><Setter Property="PlaceholderColor" Value="#6B7280" /><Setter Property="BackgroundColor" Value="White" /><Setter Property="MinimumHeightRequest" Value="70" /></Style>
        <Style TargetType="Picker"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="14" /><Setter Property="TextColor" Value="#111827" /><Setter Property="TitleColor" Value="#6B7280" /><Setter Property="BackgroundColor" Value="White" /><Setter Property="HeightRequest" Value="66" /><Setter Property="MinimumHeightRequest" Value="66" /><Setter Property="HorizontalOptions" Value="Fill" /><Setter Property="VerticalTextAlignment" Value="Center" /></Style>
        <Style TargetType="SearchBar"><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="14" /><Setter Property="TextColor" Value="#111827" /><Setter Property="PlaceholderColor" Value="#6B7280" /><Setter Property="BackgroundColor" Value="#F7F8FA" /></Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="BackgroundColor" Value="Transparent" /><Setter Property="StrokeThickness" Value="0" /><Setter Property="Padding" Value="12,16" /></Style>
        <Style x:Key="FieldLabel" TargetType="Label"><Setter Property="FontSize" Value="14" /><Setter Property="FontAttributes" Value="Bold" /><Setter Property="Margin" Value="0,2,0,0" /></Style>
        <Style x:Key="CardTitle" TargetType="Label"><Setter Property="FontSize" Value="14" /><Setter Property="FontAttributes" Value="Bold" /></Style>
        <Style x:Key="NavButton" TargetType="Button"><Setter Property="BackgroundColor" Value="White" /><Setter Property="TextColor" Value="Black" /><Setter Property="BorderColor" Value="White" /><Setter Property="HorizontalOptions" Value="Fill" /><Setter Property="Padding" Value="14,11" /></Style>
        <Style x:Key="SidebarItem" TargetType="Border"><Setter Property="BackgroundColor" Value="White" /><Setter Property="StrokeThickness" Value="0" /><Setter Property="StrokeShape" Value="RoundRectangle 6" /><Setter Property="Padding" Value="14,12" /><Setter Property="HorizontalOptions" Value="Fill" /></Style>
        <Style x:Key="SecondaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="#EFF6FF" /><Setter Property="TextColor" Value="#175CD3" /><Setter Property="BorderColor" Value="#B2CCFF" /><Setter Property="BorderWidth" Value="1" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="14,9" /></Style>
        <Style x:Key="PrimaryButton" TargetType="Button"><Setter Property="BackgroundColor" Value="#175CD3" /><Setter Property="TextColor" Value="White" /><Setter Property="BorderColor" Value="#175CD3" /><Setter Property="BorderWidth" Value="0" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="18,10" /></Style>
        <Style x:Key="DashboardPanel" TargetType="Border"><Setter Property="BackgroundColor" Value="White" /><Setter Property="Stroke" Value="#E6EAF0" /><Setter Property="StrokeThickness" Value="1" /><Setter Property="StrokeShape" Value="RoundRectangle 12" /><Setter Property="Padding" Value="18" /></Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">
        <Grid x:Name="AuthenticatedHeader" IsVisible="{Binding IsAuthenticated}" Padding="18,10" BackgroundColor="White" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto" ColumnSpacing="12">
            <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="MobileHeader"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="AdminProfile" Property="IsVisible" Value="False" /><Setter TargetName="LogoName" Property="IsVisible" Value="False" /><Setter TargetName="AuthenticatedHeader" Property="Padding" Value="12,8" /><Setter TargetName="AuthenticatedHeader" Property="RowDefinitions" Value="Auto,Auto" /><Setter TargetName="GlobalSearch" Property="Grid.Row" Value="1" /><Setter TargetName="GlobalSearch" Property="Grid.Column" Value="0" /><Setter TargetName="GlobalSearch" Property="Grid.ColumnSpan" Value="3" /><Setter TargetName="GlobalSearch" Property="WidthRequest" Value="-1" /><Setter TargetName="GlobalSearch" Property="HorizontalOptions" Value="Fill" /><Setter TargetName="GlobalSearch" Property="Margin" Value="0,8,0,0" /></VisualState.Setters></VisualState><VisualState x:Name="DesktopHeader"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="AdminProfile" Property="IsVisible" Value="True" /><Setter TargetName="LogoName" Property="IsVisible" Value="True" /><Setter TargetName="AuthenticatedHeader" Property="RowDefinitions" Value="Auto" /><Setter TargetName="GlobalSearch" Property="Grid.Row" Value="0" /><Setter TargetName="GlobalSearch" Property="Grid.Column" Value="1" /><Setter TargetName="GlobalSearch" Property="Grid.ColumnSpan" Value="1" /><Setter TargetName="GlobalSearch" Property="WidthRequest" Value="520" /><Setter TargetName="GlobalSearch" Property="HorizontalOptions" Value="Start" /><Setter TargetName="GlobalSearch" Property="Margin" Value="24,0,0,0" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
            <Grid Grid.Column="0" ColumnDefinitions="Auto,Auto" ColumnSpacing="9" VerticalOptions="Center">
                <Image Source="assetflow_icon_black.png" WidthRequest="46" HeightRequest="46" Aspect="AspectFit" VerticalOptions="Center" />
                <Image x:Name="LogoName" Grid.Column="1" Source="assetflow_logo_name.png" WidthRequest="170" HeightRequest="42" Aspect="AspectFit" VerticalOptions="Center" />
            </Grid>
            <SearchBar x:Name="GlobalSearch" Grid.Column="1" Placeholder="Pesquisar ativos e departamentos..." Text="{Binding SearchText}" WidthRequest="520" MaximumWidthRequest="620" HorizontalOptions="Start" VerticalOptions="Center" Margin="24,0,0,0" />
            <Grid x:Name="AdminProfile" Grid.Column="2" IsVisible="False" ColumnDefinitions="Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnProfileTapped" /></Grid.GestureRecognizers>
                <Image Source="icon_profile.png" WidthRequest="48" HeightRequest="48" Aspect="AspectFit" />
                <Label Grid.Column="1" Text="Administrador" FontSize="14" VerticalOptions="Center" />
            </Grid>
        </Grid>

        <!-- A tela de login foi mantida com a composição anterior. -->
        <ScrollView Grid.Row="1" IsVisible="{Binding IsLoggedOut}">
            <Grid BackgroundColor="White" Padding="24" MinimumHeightRequest="640">
                <Border BackgroundColor="White" Stroke="White" MaximumWidthRequest="420" HorizontalOptions="Fill" VerticalOptions="Center" Padding="32" StrokeShape="RoundRectangle 12">
                    <VerticalStackLayout Spacing="18" VerticalOptions="Center">
                        <Border BackgroundColor="Black" Stroke="Black" WidthRequest="58" HeightRequest="58" HorizontalOptions="Center" StrokeShape="RoundRectangle 12"><Label Text="AF" TextColor="White" FontAttributes="Bold" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" /></Border>
                        <Label Text="Login" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,4,0,12" />
                        <Label Text="Usuário" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Digite seu usuário" Text="{Binding Username}" />
                        <Label Text="Senha" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Digite sua senha" Text="{Binding Password}" IsPassword="True" />
                        <Button Text="ENTRAR" Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButton}" Margin="0,12,0,0" />
                        <BoxView HeightRequest="1" BackgroundColor="Black" Margin="0,14,0,4" />
                        <Label Text="AssetFlow Experimental" FontSize="12" HorizontalTextAlignment="Center" />
                        <Label Text="Gestão segura do ciclo de vida de ativos" FontSize="11" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <Grid x:Name="AuthenticatedShell" Grid.Row="1" IsVisible="{Binding IsAuthenticated}" ColumnDefinitions="*" RowDefinitions="Auto,*">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="MobileShell"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter TargetName="DesktopSidebar" Property="IsVisible" Value="False" /><Setter TargetName="MobileNavigation" Property="IsVisible" Value="True" /><Setter TargetName="DashboardContent" Property="Grid.Row" Value="1" /><Setter TargetName="DashboardContent" Property="Grid.Column" Value="0" /></VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="DesktopShell"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="900" /></VisualState.StateTriggers>
                        <VisualState.Setters><Setter TargetName="AuthenticatedShell" Property="ColumnDefinitions" Value="260,*" /><Setter TargetName="AuthenticatedShell" Property="RowDefinitions" Value="*" /><Setter TargetName="DesktopSidebar" Property="IsVisible" Value="True" /><Setter TargetName="MobileNavigation" Property="IsVisible" Value="False" /><Setter TargetName="DashboardContent" Property="Grid.Row" Value="0" /><Setter TargetName="DashboardContent" Property="Grid.Column" Value="1" /></VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Grid x:Name="DesktopSidebar" IsVisible="False" BackgroundColor="White" Padding="10,16,10,12" RowDefinitions="*,Auto">
                <VerticalStackLayout Spacing="5">
                    <Border BackgroundColor="#F1F3F5" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="14,12"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigationTapped" x:Name="DashboardNav" CommandParameter="dashboard" /></Border.GestureRecognizers><Grid ColumnDefinitions="46,*" ColumnSpacing="10"><Image Source="sidebar_dashboard.png" WidthRequest="40" HeightRequest="40" Aspect="AspectFit" /><Label Grid.Column="1" Text="Dashboard" FontSize="15" FontAttributes="Bold" VerticalOptions="Center" /></Grid></Border>
                    <Border Style="{StaticResource SidebarItem}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigationTapped" x:Name="InventoryNav" CommandParameter="inventory" /></Border.GestureRecognizers><Grid ColumnDefinitions="46,*" ColumnSpacing="10"><Image Source="sidebar_inventory.png" WidthRequest="40" HeightRequest="40" Aspect="AspectFit" /><Label Grid.Column="1" Text="Inventário" FontSize="15" VerticalOptions="Center" /></Grid></Border>
                    <Border Style="{StaticResource SidebarItem}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigationTapped" x:Name="AssetsNav" CommandParameter="assets" /></Border.GestureRecognizers><Grid ColumnDefinitions="46,*" ColumnSpacing="10"><Image Source="sidebar_assets.png" WidthRequest="40" HeightRequest="40" Aspect="AspectFit" /><Label Grid.Column="1" Text="Ativos" FontSize="15" VerticalOptions="Center" /></Grid></Border>
                    <Border Style="{StaticResource SidebarItem}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigationTapped" x:Name="DepartmentsNav" CommandParameter="departments" /></Border.GestureRecognizers><Grid ColumnDefinitions="46,*" ColumnSpacing="10"><Image Source="sidebar_departments.png" WidthRequest="40" HeightRequest="40" Aspect="AspectFit" /><Label Grid.Column="1" Text="Departamentos" FontSize="15" VerticalOptions="Center" /></Grid></Border>
                    <Border Style="{StaticResource SidebarItem}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigationTapped" x:Name="MovementsNav" CommandParameter="movements" /></Border.GestureRecognizers><Grid ColumnDefinitions="46,*" ColumnSpacing="10"><Image Source="sidebar_movements.png" WidthRequest="40" HeightRequest="40" Aspect="AspectFit" /><Label Grid.Column="1" Text="Movimentações" FontSize="15" VerticalOptions="Center" /></Grid></Border>
                    <Border Style="{StaticResource SidebarItem}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigationTapped" x:Name="ReportsNav" CommandParameter="reports" /></Border.GestureRecognizers><Grid ColumnDefinitions="46,*" ColumnSpacing="10"><Image Source="sidebar_reports.png" WidthRequest="40" HeightRequest="40" Aspect="AspectFit" /><Label Grid.Column="1" Text="Relatórios" FontSize="15" VerticalOptions="Center" /></Grid></Border>
                    <Border Style="{StaticResource SidebarItem}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigationTapped" x:Name="UsersNav" CommandParameter="users" /></Border.GestureRecognizers><Grid ColumnDefinitions="46,*" ColumnSpacing="10"><Image Source="sidebar_users.png" WidthRequest="40" HeightRequest="40" Aspect="AspectFit" /><Label Grid.Column="1" Text="Usuários" FontSize="15" VerticalOptions="Center" /></Grid></Border>
                    <Border Style="{StaticResource SidebarItem}"><Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNavigationTapped" x:Name="SettingsNav" CommandParameter="settings" /></Border.GestureRecognizers><Grid ColumnDefinitions="46,*" ColumnSpacing="10"><Image Source="sidebar_settings.png" WidthRequest="40" HeightRequest="40" Aspect="AspectFit" /><Label Grid.Column="1" Text="Configurações" FontSize="15" VerticalOptions="Center" /></Grid></Border>
                </VerticalStackLayout>
                <Button Grid.Row="1" Text="↪  Sair" Clicked="OnLogoutClicked" BackgroundColor="Transparent" TextColor="#B42318" BorderWidth="0" FontAttributes="Bold" HorizontalOptions="Start" />
            </Grid>
            <ScrollView x:Name="MobileNavigation" Orientation="Horizontal" HorizontalScrollBarVisibility="Never" Padding="10,8">
                <HorizontalStackLayout Spacing="8"><Button Text="Dashboard" CommandParameter="dashboard" Clicked="OnMobileNavigationClicked" BackgroundColor="Black" TextColor="White" /><Button Text="Inventário" CommandParameter="inventory" Clicked="OnMobileNavigationClicked" Style="{StaticResource SecondaryButton}" /><Button Text="Ativos" CommandParameter="assets" Clicked="OnMobileNavigationClicked" Style="{StaticResource SecondaryButton}" /><Button Text="Departamentos" CommandParameter="departments" Clicked="OnMobileNavigationClicked" Style="{StaticResource SecondaryButton}" /><Button Text="Movimentações" CommandParameter="movements" Clicked="OnMobileNavigationClicked" Style="{StaticResource SecondaryButton}" /><Button Text="Sair" Clicked="OnLogoutClicked" BackgroundColor="Transparent" TextColor="#B42318" BorderWidth="0" /></HorizontalStackLayout>
            </ScrollView>

            <Grid x:Name="DashboardContent" Grid.Row="1" BackgroundColor="#FCFCFD" RowDefinitions="*,Auto">
                <ScrollView x:Name="AuthenticatedScroll" Grid.Row="0">
                    <VerticalStackLayout Padding="24" Spacing="18" HorizontalOptions="Fill">
                        <Grid x:Name="DashboardTop" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="3"><Label x:Name="SectionTitle" Text="Dashboard" FontSize="30" FontAttributes="Bold" /><Label x:Name="SectionSubtitle" Text="Visão geral do inventário de ativos da sua empresa" TextColor="#667085" /></VerticalStackLayout>
                            <Button Grid.Column="1" Text="↻" FontSize="22" WidthRequest="38" HeightRequest="38" MinimumWidthRequest="38" MinimumHeightRequest="38" CornerRadius="7" Padding="0" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" SemanticProperties.Description="Sincronizar dados" />
                            <Border x:Name="NewAssetAction" Grid.Column="2" IsVisible="False" BackgroundColor="#175CD3" Stroke="#175CD3" StrokeShape="RoundRectangle 8" Padding="14,9" VerticalOptions="Center" SemanticProperties.Description="Novo ativo">
                                <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnNewAssetClicked" /></Border.GestureRecognizers>
                                <Grid ColumnDefinitions="18,Auto" ColumnSpacing="8">
                                    <Label Text="+" TextColor="White" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                                    <Label Grid.Column="1" Text="Novo ativo" TextColor="White" FontAttributes="Bold" VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <Grid x:Name="StatsGrid" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                            <VisualStateManager.VisualStateGroups><VisualStateGroup>
                                <VisualState x:Name="CompactStats"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState>
                                <VisualState x:Name="WideStats"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1400" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="StatsGrid" Property="ColumnDefinitions" Value="*,*,*,*" /><Setter TargetName="StatsGrid" Property="RowDefinitions" Value="Auto" /><Setter TargetName="AvailableCard" Property="Grid.Row" Value="0" /><Setter TargetName="AvailableCard" Property="Grid.Column" Value="1" /><Setter TargetName="AssignedCard" Property="Grid.Row" Value="0" /><Setter TargetName="AssignedCard" Property="Grid.Column" Value="2" /><Setter TargetName="MaintenanceCard" Property="Grid.Row" Value="0" /><Setter TargetName="MaintenanceCard" Property="Grid.Column" Value="3" /></VisualState.Setters></VisualState>
                            </VisualStateGroup></VisualStateManager.VisualStateGroups>
                            <Border Style="{StaticResource DashboardPanel}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="16"><Image Source="icon_total_assets.png" WidthRequest="62" HeightRequest="62" Aspect="AspectFit" /><VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="{Binding TotalAssetCount}" FontSize="26" FontAttributes="Bold" /><Label Text="Total de ativos" FontAttributes="Bold" /><Label Text="Todos os ativos cadastrados" FontSize="12" TextColor="#667085" /></VerticalStackLayout></Grid></Border>
                            <Border x:Name="AvailableCard" Grid.Column="1" Style="{StaticResource DashboardPanel}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="16"><Image Source="icon_available.png" WidthRequest="62" HeightRequest="62" Aspect="AspectFit" /><VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="{Binding AvailableAssetCount}" FontSize="26" FontAttributes="Bold" /><Label Text="Disponíveis" FontAttributes="Bold" /><Label Text="Prontos para uso" FontSize="12" TextColor="#667085" /></VerticalStackLayout></Grid></Border>
                            <Border x:Name="AssignedCard" Grid.Row="1" Style="{StaticResource DashboardPanel}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="16"><Image Source="icon_assigned.png" WidthRequest="62" HeightRequest="62" Aspect="AspectFit" /><VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="{Binding AssignedAssetCount}" FontSize="26" FontAttributes="Bold" /><Label Text="Atribuídos" FontAttributes="Bold" /><Label Text="Em uso por colaboradores" FontSize="12" TextColor="#667085" /></VerticalStackLayout></Grid></Border>
                            <Border x:Name="MaintenanceCard" Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardPanel}"><Grid ColumnDefinitions="Auto,*" ColumnSpacing="16"><Image Source="icon_maintenance.png" WidthRequest="62" HeightRequest="62" Aspect="AspectFit" /><VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center"><Label Text="{Binding MaintenanceAssetCount}" FontSize="26" FontAttributes="Bold" /><Label Text="Em manutenção" FontAttributes="Bold" /><Label Text="Indisponíveis temporariamente" FontSize="12" TextColor="#667085" /></VerticalStackLayout></Grid></Border>
                        </Grid>

                        <BoxView x:Name="DashboardDivider" HeightRequest="1" BackgroundColor="#D9DEE7" />

                        <Grid x:Name="DashboardInsights" ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="16">
                            <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="CompactInsights"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="DepartmentPanel" Property="Grid.Row" Value="1" /><Setter TargetName="QuickViewPanel" Property="Grid.Row" Value="2" /><Setter TargetName="RecentMovementsPanel" Property="Grid.Row" Value="3" /><Setter TargetName="RecentAssetsPanel" Property="Grid.Row" Value="4" /><Setter TargetName="DashboardQuickActions" Property="Grid.Row" Value="5" /></VisualState.Setters></VisualState><VisualState x:Name="WideInsights"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1450" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="DashboardInsights" Property="ColumnDefinitions" Value="1.25*,1.1*,.75*" /><Setter TargetName="DashboardInsights" Property="RowDefinitions" Value="Auto,Auto" /><Setter TargetName="DepartmentPanel" Property="Grid.Row" Value="0" /><Setter TargetName="DepartmentPanel" Property="Grid.Column" Value="1" /><Setter TargetName="QuickViewPanel" Property="Grid.Row" Value="0" /><Setter TargetName="QuickViewPanel" Property="Grid.Column" Value="2" /><Setter TargetName="RecentMovementsPanel" Property="Grid.Row" Value="1" /><Setter TargetName="RecentAssetsPanel" Property="Grid.Row" Value="1" /><Setter TargetName="RecentAssetsPanel" Property="Grid.Column" Value="1" /><Setter TargetName="DashboardQuickActions" Property="Grid.Row" Value="1" /><Setter TargetName="DashboardQuickActions" Property="Grid.Column" Value="2" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
                            <Border Style="{StaticResource DashboardPanel}"><VerticalStackLayout Spacing="14"><Label Text="Distribuição por status" FontSize="17" FontAttributes="Bold" /><Grid ColumnDefinitions="150,*" ColumnSpacing="16"><Border WidthRequest="142" HeightRequest="142" Stroke="#DDE3EA" StrokeThickness="18" StrokeShape="RoundRectangle 71" HorizontalOptions="Center"><VerticalStackLayout VerticalOptions="Center" Spacing="0"><Label Text="{Binding TotalAssetCount}" FontSize="24" FontAttributes="Bold" HorizontalTextAlignment="Center" /><Label Text="ativos" FontSize="12" TextColor="#667085" HorizontalTextAlignment="Center" /></VerticalStackLayout></Border><VerticalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center"><Grid ColumnDefinitions="12,*,Auto"><BoxView BackgroundColor="#00A85A" CornerRadius="6" HeightRequest="12" WidthRequest="12" /><Label Grid.Column="1" Text="Disponíveis" /><Label Grid.Column="2" Text="{Binding AvailableAssetCount}" /></Grid><Grid ColumnDefinitions="12,*,Auto"><BoxView BackgroundColor="#2167D7" CornerRadius="6" HeightRequest="12" WidthRequest="12" /><Label Grid.Column="1" Text="Atribuídos" /><Label Grid.Column="2" Text="{Binding AssignedAssetCount}" /></Grid><Grid ColumnDefinitions="12,*,Auto"><BoxView BackgroundColor="#F79009" CornerRadius="6" HeightRequest="12" WidthRequest="12" /><Label Grid.Column="1" Text="Em manutenção" /><Label Grid.Column="2" Text="{Binding MaintenanceAssetCount}" /></Grid></VerticalStackLayout></Grid></VerticalStackLayout></Border>
                            <Border x:Name="DepartmentPanel" Grid.Row="1" Style="{StaticResource DashboardPanel}"><VerticalStackLayout Spacing="14"><Label Text="Ativos por departamento" FontSize="17" FontAttributes="Bold" /><VerticalStackLayout Spacing="10" VerticalOptions="Center"><Label Text="A distribuição será exibida após cadastrar departamentos e atribuir ativos." TextColor="#667085" HorizontalTextAlignment="Center" /><Button Text="Gerenciar departamentos" CommandParameter="departments" Clicked="OnMobileNavigationClicked" Style="{StaticResource SecondaryButton}" HorizontalOptions="Center" /></VerticalStackLayout></VerticalStackLayout></Border>
                            <Border x:Name="QuickViewPanel" Grid.Row="2" Style="{StaticResource DashboardPanel}"><VerticalStackLayout Spacing="12"><Label Text="Visão rápida" FontSize="17" FontAttributes="Bold" /><Grid ColumnDefinitions="*,Auto"><Label Text="Ativos sem atribuição" /><Label Grid.Column="1" Text="{Binding AvailableAssetCount}" FontAttributes="Bold" /></Grid><BoxView HeightRequest="1" BackgroundColor="#EEF1F5" /><Grid ColumnDefinitions="*,Auto"><Label Text="Em manutenção" /><Label Grid.Column="1" Text="{Binding MaintenanceAssetCount}" FontAttributes="Bold" /></Grid><BoxView HeightRequest="1" BackgroundColor="#EEF1F5" /><Grid ColumnDefinitions="*,Auto"><Label Text="Total de departamentos" /><Label Grid.Column="1" Text="{Binding Departments.Count}" FontAttributes="Bold" /></Grid></VerticalStackLayout></Border>
                            <Border x:Name="RecentMovementsPanel" Grid.Row="1" Style="{StaticResource DashboardPanel}"><VerticalStackLayout Spacing="12"><Grid ColumnDefinitions="*,Auto"><Label Text="Últimas movimentações" FontSize="17" FontAttributes="Bold" /><Button Grid.Column="1" Text="Ver todas" CommandParameter="movements" Clicked="OnMobileNavigationClicked" Style="{StaticResource SecondaryButton}" FontSize="12" /></Grid><BoxView HeightRequest="1" BackgroundColor="#EEF1F5" /><VerticalStackLayout Spacing="5" Padding="0,12"><Label Text="Nenhuma movimentação registrada" FontAttributes="Bold" HorizontalTextAlignment="Center" /><Label Text="As movimentações de ativos aparecerão aqui." FontSize="12" TextColor="#667085" HorizontalTextAlignment="Center" /><Button Text="Registrar movimentação" CommandParameter="inventory" Clicked="OnMobileNavigationClicked" Style="{StaticResource PrimaryButton}" HorizontalOptions="Center" Margin="0,6,0,0" /></VerticalStackLayout></VerticalStackLayout></Border>
                            <Border x:Name="RecentAssetsPanel" Grid.Row="2" Style="{StaticResource DashboardPanel}"><VerticalStackLayout Spacing="10"><Grid ColumnDefinitions="*,Auto"><Label Text="Ativos recentes" FontSize="17" FontAttributes="Bold" /><Button Grid.Column="1" Text="Ver todos" CommandParameter="inventory" Clicked="OnMobileNavigationClicked" Style="{StaticResource SecondaryButton}" FontSize="12" /></Grid><BoxView HeightRequest="1" BackgroundColor="#EEF1F5" /><CollectionView ItemsSource="{Binding Assets}" HeightRequest="145" SelectionMode="None"><CollectionView.EmptyView><VerticalStackLayout Spacing="5" Padding="0,16"><Label Text="Nenhum ativo cadastrado" FontAttributes="Bold" HorizontalTextAlignment="Center" /><Label Text="Comece cadastrando o primeiro ativo." FontSize="12" TextColor="#667085" HorizontalTextAlignment="Center" /></VerticalStackLayout></CollectionView.EmptyView><CollectionView.ItemTemplate><DataTemplate><Grid Padding="4,7" ColumnDefinitions="1.1*,2*,Auto" ColumnSpacing="10"><Label Text="{Binding Code}" FontAttributes="Bold" /><Label Grid.Column="1" Text="{Binding Name}" LineBreakMode="TailTruncation" /><Label Grid.Column="2" Text="{Binding StatusName}" TextColor="#667085" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></Border>
                            <Border x:Name="DashboardQuickActions" Grid.Row="3" Style="{StaticResource DashboardPanel}"><VerticalStackLayout Spacing="12"><Label Text="Ações rápidas" FontSize="17" FontAttributes="Bold" /><Button Text="Cadastrar ativo" CommandParameter="assets" Clicked="OnMobileNavigationClicked" Style="{StaticResource PrimaryButton}" /><Button Text="Novo departamento" CommandParameter="departments" Clicked="OnMobileNavigationClicked" Style="{StaticResource SecondaryButton}" /><Button Text="Ver inventário" CommandParameter="inventory" Clicked="OnMobileNavigationClicked" Style="{StaticResource SecondaryButton}" /></VerticalStackLayout></Border>
                        </Grid>

                        <Grid x:Name="FormsGrid" IsVisible="False" ColumnDefinitions="*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14" MaximumWidthRequest="1180" HorizontalOptions="Start">
                            <Border x:Name="DepartmentFormCard" Style="{StaticResource Card}" MaximumWidthRequest="760"><VerticalStackLayout Spacing="7"><Label Text="Cadastrar ou editar departamento" Style="{StaticResource CardTitle}" /><Label Text="Nome" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Ex.: Tecnologia" Text="{Binding DepartmentName}" /><Label Text="Descrição / localização" Style="{StaticResource FieldLabel}" /><Editor Placeholder="Ex.: Responsável pelos recursos de TI" Text="{Binding DepartmentDescription}" AutoSize="TextChanges" /><Button Text="{Binding DepartmentSubmitText}" Command="{Binding AddDepartmentCommand}" Style="{StaticResource PrimaryButton}" WidthRequest="230" HorizontalOptions="Start" Margin="0,6,0,0" /></VerticalStackLayout></Border>
                            <Border x:Name="AssetFormCard" Grid.Row="1" Style="{StaticResource Card}" MaximumWidthRequest="1180"><VerticalStackLayout Spacing="7"><Label Text="Cadastrar ou editar ativo" Style="{StaticResource CardTitle}" /><Grid x:Name="AssetFields" ColumnDefinitions="*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="5"><VerticalStackLayout><Label Text="Código patrimonial" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Ex.: PAT-0001" Text="{Binding AssetCode}" /></VerticalStackLayout><VerticalStackLayout x:Name="SerialField" Grid.Row="1"><Label Text="Número de série" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Ex.: SN-123" Text="{Binding AssetSerialNumber}" /></VerticalStackLayout><VerticalStackLayout x:Name="AssetNameField" Grid.Row="2"><Label Text="Nome do ativo" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Ex.: Notebook Dell Latitude" Text="{Binding AssetName}" /></VerticalStackLayout><VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="StackedAssetFields"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState><VisualState x:Name="SideAssetFields"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="AssetFields" Property="ColumnDefinitions" Value="*,*,*" /><Setter TargetName="AssetFields" Property="RowDefinitions" Value="Auto" /><Setter TargetName="SerialField" Property="Grid.Row" Value="0" /><Setter TargetName="SerialField" Property="Grid.Column" Value="1" /><Setter TargetName="AssetNameField" Property="Grid.Row" Value="0" /><Setter TargetName="AssetNameField" Property="Grid.Column" Value="2" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups></Grid><Label Text="Descrição personalizada" Style="{StaticResource FieldLabel}" /><Editor Placeholder="Detalhes, características e observações" Text="{Binding AssetDescription}" AutoSize="TextChanges" /><Label Text="Departamento / localização inicial" Style="{StaticResource FieldLabel}" /><Picker Title="Selecione o departamento do ativo" ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedAssetDepartment}" ItemDisplayBinding="{Binding Name}" /><Button Text="{Binding AssetSubmitText}" Command="{Binding AddAssetCommand}" Style="{StaticResource PrimaryButton}" WidthRequest="230" HorizontalOptions="Start" Margin="0,6,0,0" /></VerticalStackLayout></Border>
                        </Grid>

                        <BoxView x:Name="FormsDivider" IsVisible="False" HeightRequest="1" BackgroundColor="#D9DEE7" />

                        <Grid x:Name="ListsGrid" IsVisible="False" ColumnDefinitions="*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="14">
                            <Border x:Name="DepartmentsCard" Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Image Source="sidebar_departments.png" WidthRequest="32" HeightRequest="32" /><Label Grid.Column="1" Text="Departamentos" Style="{StaticResource CardTitle}" VerticalOptions="Center" /><Label Grid.Column="2" Text="{Binding Departments.Count, StringFormat='Total: {0}'}" VerticalOptions="Center" /></Grid><BoxView HeightRequest="1" BackgroundColor="#D9DEE7" /><CollectionView ItemsSource="{Binding Departments}" HeightRequest="300" SelectionMode="None"><CollectionView.ItemTemplate><DataTemplate><Grid Padding="3,10" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8"><VerticalStackLayout Spacing="0"><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Description}" TextColor="#667085" /></VerticalStackLayout><Button Grid.Column="1" Text="Editar" Clicked="OnEditDepartmentClicked" BackgroundColor="Transparent" TextColor="#175CD3" /><Button Grid.Column="2" Text="Excluir" Clicked="OnDeleteDepartmentClicked" BackgroundColor="Transparent" TextColor="#B42318" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></Border>
                            <Border x:Name="InventoryCard" Grid.Row="1" Style="{StaticResource Card}"><VerticalStackLayout Spacing="8"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10"><Image Source="sidebar_inventory.png" WidthRequest="32" HeightRequest="32" /><Label Grid.Column="1" Text="Inventário de ativos" Style="{StaticResource CardTitle}" VerticalOptions="Center" /><Label Grid.Column="2" Text="{Binding Assets.Count, StringFormat='Total: {0}'}" VerticalOptions="Center" /></Grid><Grid Padding="5,7" ColumnDefinitions="1.1*,2*,1*,Auto,Auto" ColumnSpacing="10"><Label Text="CÓDIGO" Style="{StaticResource FieldLabel}" /><Label Grid.Column="1" Text="ATIVO" Style="{StaticResource FieldLabel}" /><Label Grid.Column="2" Text="STATUS" Style="{StaticResource FieldLabel}" /></Grid><CollectionView ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" SelectionMode="Single" HeightRequest="330"><CollectionView.ItemTemplate><DataTemplate><Grid Padding="16,9" ColumnDefinitions="1.1*,2*,1*,Auto,Auto" ColumnSpacing="10"><Label Text="{Binding Code}" FontAttributes="Bold" /><VerticalStackLayout Grid.Column="1" Spacing="0"><Label Text="{Binding Name}" FontAttributes="Bold" /><Label Text="{Binding Description}" TextColor="#667085" /></VerticalStackLayout><Border Grid.Column="2" BackgroundColor="#EEF2F6" StrokeThickness="0" Padding="8,4" StrokeShape="RoundRectangle 10" VerticalOptions="Center"><Label Text="{Binding StatusName}" /></Border><Button Grid.Column="3" Text="Editar" Clicked="OnEditAssetClicked" BackgroundColor="Transparent" TextColor="#175CD3" /><Button Grid.Column="4" Text="Excluir" Clicked="OnDeleteAssetClicked" BackgroundColor="Transparent" TextColor="#B42318" /></Grid></DataTemplate></CollectionView.ItemTemplate></CollectionView></VerticalStackLayout></Border>
                        </Grid>

                        <Border x:Name="DetailsCard" IsVisible="False" Style="{StaticResource Card}">
                            <Grid x:Name="DetailsGrid" ColumnDefinitions="*" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="12">
                                <VisualStateManager.VisualStateGroups><VisualStateGroup><VisualState x:Name="StackedDetails"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers></VisualState><VisualState x:Name="SideDetails"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1050" /></VisualState.StateTriggers><VisualState.Setters><Setter TargetName="DetailsGrid" Property="ColumnDefinitions" Value="1.2*,1.8*" /><Setter TargetName="DetailsGrid" Property="RowDefinitions" Value="Auto" /><Setter TargetName="HistoryPanel" Property="Grid.Row" Value="0" /><Setter TargetName="HistoryPanel" Property="Grid.Column" Value="1" /></VisualState.Setters></VisualState></VisualStateGroup></VisualStateManager.VisualStateGroups>
                                <VerticalStackLayout Spacing="8"><Label Text="Ativo selecionado" Style="{StaticResource CardTitle}" /><Label Text="{Binding SelectedAsset.Summary}" FontAttributes="Bold" /><Label Text="{Binding SelectedAsset.StatusName, StringFormat='Status atual: {0}'}" /><Label Text="IDENTIFICADOR QR" Style="{StaticResource FieldLabel}" /><Label Text="{Binding SelectedAsset.QrCodeValue}" LineBreakMode="TailTruncation" /><Button Text="Copiar identificador QR" Command="{Binding CopyQrCommand}" Style="{StaticResource SecondaryButton}" /><Label Text="DEPARTAMENTO DE DESTINO" Style="{StaticResource FieldLabel}" /><Picker Title="Selecione um departamento" ItemsSource="{Binding Departments}" SelectedItem="{Binding SelectedDepartment}" ItemDisplayBinding="{Binding Name}" /><Label Text="OBSERVAÇÕES" Style="{StaticResource FieldLabel}" /><Entry Placeholder="Motivo ou detalhes da movimentação" Text="{Binding MovementNotes}" /><Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8"><Button Text="{Binding MoveButtonText}" Command="{Binding MoveAssetCommand}" Style="{StaticResource PrimaryButton}" WidthRequest="180" /><Button Grid.Column="1" Text="Devolver" Command="{Binding ReturnAssetCommand}" Style="{StaticResource SecondaryButton}" WidthRequest="120" /></Grid></VerticalStackLayout>
                                <VerticalStackLayout x:Name="HistoryPanel" Grid.Row="1" Spacing="8"><Label Text="Histórico de movimentações" Style="{StaticResource CardTitle}" /><Label IsVisible="{Binding SelectedAsset.HasNoMovements}" Text="Este ativo ainda não possui movimentações." Padding="0,10" /><VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedAsset.Movements}"><BindableLayout.ItemTemplate><DataTemplate><Grid Padding="10" ColumnDefinitions="5,*" ColumnSpacing="10"><BoxView BackgroundColor="Black" /><Label Grid.Column="1" Text="{Binding Summary}" VerticalOptions="Center" /></Grid></DataTemplate></BindableLayout.ItemTemplate></VerticalStackLayout></VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" Padding="24,10" BackgroundColor="#FCFCFD"><Image Source="assetflow_icon_black.png" WidthRequest="25" HeightRequest="25" /><Image Grid.Column="1" Source="assetflow_logo_name.png" WidthRequest="104" HeightRequest="25" Aspect="AspectFit" /><Label Grid.Column="2" Text="AssetFlow experimental" HorizontalTextAlignment="End" VerticalTextAlignment="Center" TextColor="#667085" /></Grid>
            </Grid>
        </Grid>

        <Border x:Name="ConnectionBanner" Grid.Row="0" Grid.RowSpan="2" IsVisible="False" ZIndex="100" BackgroundColor="White" Stroke="Black" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,10" Margin="16" HorizontalOptions="Center" VerticalOptions="Start">
            <Grid ColumnDefinitions="36,Auto" ColumnSpacing="10">
                <Image x:Name="ConnectionBannerIcon" Source="connection_lost.png" WidthRequest="32" HeightRequest="32" Aspect="AspectFit" />
                <Label x:Name="ConnectionBannerText" Grid.Column="1" Text="Sem conexão com a internet." FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Padding="16,8" BackgroundColor="Black" ColumnDefinitions="Auto,*">
            <ActivityIndicator IsRunning="{Binding IsBusy}" Color="White" />
            <Label Grid.Column="1" Text="{Binding StatusMessage}" TextColor="White" FontSize="14" VerticalOptions="Center" LineBreakMode="TailTruncation" />
        </Grid>
    </Grid>
</ContentPage>
